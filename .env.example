# Required
MISTRAL_API_KEY=

# Optional overrides (defaults shown)
# MISTRAL_BASE_URL=https://api.eu.mistral.ai
# MISTRAL_MODEL=mistral-large-4
# STREAM_IDLE_TIMEOUT_MS=600000   # max silence mid-stream (dead connection)
# REQUEST_TIMEOUT_MS=300000       # wait for response headers only; answers themselves are never timed
# MAX_DOC_CHARS=400000

# Corporate network (read by Bun itself, not by MISTI)
# HTTPS_PROXY=http://proxy.corp:8080
# NODE_EXTRA_CA_CERTS=/path/to/corp-root-ca.pem

# Tests only (production always binds 31571)
# MISTI_PORT=31571
